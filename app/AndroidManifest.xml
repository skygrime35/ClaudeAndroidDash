<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.claudedash.widget"
    android:versionCode="36"
    android:versionName="2.28">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <application
        android:label="Claude Dash"
        android:icon="@android:drawable/ic_menu_recent_history"
        android:allowBackup="true">

        <activity
            android:name=".ui.OnboardingActivity"
            android:exported="true"
            android:label="Claude Dash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".UsageWidget"
            android:exported="true"
            android:label="Anthropic">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.claudedash.widget.ACTION_REFRESH" />
                <action android:name="com.claudedash.widget.ACTION_UPDATE_ALL" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <receiver
            android:name=".GeminiUsageWidget"
            android:exported="true"
            android:label="Google">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.claudedash.widget.ACTION_REFRESH_GEMINI" />
                <action android:name="com.claudedash.widget.ACTION_UPDATE_ALL" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_gemini" />
        </receiver>

        <receiver
            android:name=".CombinedUsageWidget"
            android:exported="true"
            android:label="Anthropic + Google">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.claudedash.widget.ACTION_REFRESH_COMBINED" />
                <action android:name="com.claudedash.widget.ACTION_UPDATE_ALL" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_combined" />
        </receiver>

        <activity
            android:name=".RefreshActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:exported="false" />
    </application>
</manifest>
