<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:background="@drawable/widget_bg">

    <!-- Row 1: Column Titles at the very top, centered horizontally -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">
        
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Anthropic"
            android:textColor="#A0A0B0"
            android:textStyle="bold"
            android:textSize="9sp"
            android:gravity="center_horizontal" />

        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Google"
            android:textColor="#A0A0B0"
            android:textStyle="bold"
            android:textSize="9sp"
            android:gravity="center_horizontal" />
    </LinearLayout>

    <!-- Row 2: Columns Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Column 1: Anthropic (Claude) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_gravity="center_vertical">

            <!-- Row 1: 5h -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">
                <LinearLayout
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="18dp"
                        android:layout_height="wrap_content"
                        android:text="5h"
                        android:textColor="#A0A0B0"
                        android:textStyle="bold"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/block_remaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#60FFFFFF"
                        android:textSize="8sp"
                        android:singleLine="true" />
                </LinearLayout>
                <ProgressBar
                    android:id="@+id/block_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="5dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="6dp"
                    android:layout_marginRight="6dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_block" />
                <TextView
                    android:id="@+id/block_pct"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:gravity="right"
                    android:text="—"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Row 2: 7j -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">
                <LinearLayout
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="18dp"
                        android:layout_height="wrap_content"
                        android:text="7j"
                        android:textColor="#A0A0B0"
                        android:textStyle="bold"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/week_remaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#60FFFFFF"
                        android:textSize="8sp"
                        android:singleLine="true" />
                </LinearLayout>
                <ProgressBar
                    android:id="@+id/week_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="5dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="6dp"
                    android:layout_marginRight="6dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_total" />
                <TextView
                    android:id="@+id/week_pct"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:gravity="right"
                    android:text="—"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Separator Line -->
        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:background="#20FFFFFF" />

        <!-- Column 2: Google (Gemini + Claude) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_gravity="center_vertical">

            <!-- Row 1: Gemini 5h -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="1dp"
                android:paddingBottom="1dp">
                <LinearLayout
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="18dp"
                        android:layout_height="wrap_content"
                        android:text="G5"
                        android:textColor="#A0A0B0"
                        android:textStyle="bold"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/gem5_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#60FFFFFF"
                        android:textSize="8sp"
                        android:singleLine="true" />
                </LinearLayout>
                <ProgressBar
                    android:id="@+id/gem5_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="5dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="6dp"
                    android:layout_marginRight="6dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_gemini" />
                <TextView
                    android:id="@+id/gem5_val"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:gravity="right"
                    android:text="—"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Row 3: Gemini 7j -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="1dp"
                android:paddingBottom="1dp">
                <LinearLayout
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="18dp"
                        android:layout_height="wrap_content"
                        android:text="G7"
                        android:textColor="#A0A0B0"
                        android:textStyle="bold"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/gemw_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#60FFFFFF"
                        android:textSize="8sp"
                        android:singleLine="true" />
                </LinearLayout>
                <ProgressBar
                    android:id="@+id/gemw_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="5dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="6dp"
                    android:layout_marginRight="6dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_gemini" />
                <TextView
                    android:id="@+id/gemw_val"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:gravity="right"
                    android:text="—"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Row 4: Claude Google 5h -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="1dp"
                android:paddingBottom="1dp">
                <LinearLayout
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="18dp"
                        android:layout_height="wrap_content"
                        android:text="C5"
                        android:textColor="#A0A0B0"
                        android:textStyle="bold"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/clg5_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#60FFFFFF"
                        android:textSize="8sp"
                        android:singleLine="true" />
                </LinearLayout>
                <ProgressBar
                    android:id="@+id/clg5_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="5dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="6dp"
                    android:layout_marginRight="6dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_block" />
                <TextView
                    android:id="@+id/clg5_val"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:gravity="right"
                    android:text="—"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Row 5: Claude Google 7j -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="1dp"
                android:paddingBottom="1dp">
                <LinearLayout
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="18dp"
                        android:layout_height="wrap_content"
                        android:text="C7"
                        android:textColor="#A0A0B0"
                        android:textStyle="bold"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/clgw_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#60FFFFFF"
                        android:textSize="8sp"
                        android:singleLine="true" />
                </LinearLayout>
                <ProgressBar
                    android:id="@+id/clgw_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="5dp"
                    android:layout_weight="1"
                    android:layout_marginLeft="6dp"
                    android:layout_marginRight="6dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_block" />
                <TextView
                    android:id="@+id/clgw_val"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:gravity="right"
                    android:text="—"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
